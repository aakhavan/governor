# Copy to .env (never committed) and fill in. Placeholders only.
# Bearer tokens per role: role:token pairs, comma-separated.
GOVERNOR_API_TOKENS=analyst:<analyst-token>,finance_admin:<finance-admin-token>
# fake = offline answers; openrouter = real models (set OPENROUTER_API_KEY in .env)
GOVERNOR_LLM=fake
OPENROUTER_API_KEY=
# Store question text in decision traces (off by default)
GOVERNOR_TRACE_TEXT=0
